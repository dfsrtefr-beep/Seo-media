// Prisma schema for seo-media
// PostgreSQL provider

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  slug          String    @unique
  bio           String?
  avatarUrl     String?
  role          UserRole  @default(AUTHOR)
  jobTitle      String?
  website       String?
  twitter       String?
  linkedin      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  articles      Article[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  metaTitle   String?
  metaDesc    String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([slug])
}

model Tag {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[] @relation("ArticleTags")

  @@index([slug])
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String        @db.Text
  coverImageUrl String?
  coverImageAlt String?

  status        ArticleStatus @default(DRAFT)

  // SEO
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  secondaryKeywords String[] @default([])
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImageUrl     String?
  noindex        Boolean       @default(false)

  // timing
  publishedAt  DateTime?
  scheduledAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId   String
  author     User          @relation(fields: [authorId], references: [id])

  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id])

  tags       Tag[]         @relation("ArticleTags")

  // SEO: related articles (many-to-many self relation)
  related         Article[] @relation("ArticleRelated")
  relatedOf       Article[] @relation("ArticleRelated")

  @@index([slug])
  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
}

model MediaImage {
  id          String   @id @default(cuid())
  filename    String
  url         String
  alt         String?
  width       Int?
  height      Int?
  sizeBytes   Int?
  mimeType    String?
  createdAt   DateTime @default(now())
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
